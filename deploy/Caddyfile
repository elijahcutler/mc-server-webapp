# Caddy serves the static build; only /api/* reaches the Node process.
# Replace the site address and root with your own.
mc.example.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/mc-server-webapp/out
		try_files {path} {path}/index.html {path}.html
		file_server
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
