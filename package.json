{
  "name": "mmc-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "test": "node --test server/*.test.mjs && node --experimental-strip-types --no-warnings --test lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "serve": "STATIC_DIR=out node --env-file-if-exists=.env.local server/index.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^12.3.0",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "engines": {
    "node": ">=22.9"
  }
}
