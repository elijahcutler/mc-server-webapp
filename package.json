    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-preact": "^1.52.0",
    "preact": "^10.29.8",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
